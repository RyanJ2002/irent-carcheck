# 擇一啟用 Gemini（拍攝面、車牌、整潔度、新車損成對比較）
GEMINI_API_KEY=
# 或用 Vertex AI（Google Cloud 專案）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=asia-east1

GEMINI_MODEL=gemini-2.5-flash
# 自我一致性：同一題問幾次（越多信心越準，成本越高）
GEMINI_SAMPLES=3

# 沒有任何模型時，產生「模擬結果」展示介面（畫面會明確標示）
DEMO_MOCK=0

# 分流門檻（也可以在儀表板調整）
# R_PASS_MAX=0.20
# R_ALERT_MIN=0.80
